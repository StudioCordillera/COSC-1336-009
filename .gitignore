# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.env/
.venv/
venv/
ENV/

# VS Code settings (keep .vscode if you want workspace settings tracked selectively)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Logs / dumps
*.log

# OS files
.DS_Store
Thumbs.db

# Jupyter / IPython
.ipynb_checkpoints/

# Coverage / test artifacts
htmlcov/
.coverage*
.pytest_cache/

# Obsidian smart-env (files with too long names)
__OBSIDIAN_VAULT__/.smart-env/

# -------------------------------------------------
# Large / binary teaching assets (optional ignores)
# These patterns ignore future added bulky files to
# reduce VS Code indexing overhead. Already tracked
# binaries will remain unless removed manually.
# Comment out any you still want to version.
*.pptx
*.pdf
*.zip

# If you prefer only specific classroom zips ignored,
# replace the generic '*.zip' with a narrower pattern like:
# 00_CLASS_MATERIALS/Competencies/*/*.zip
# -------------------------------------------------
